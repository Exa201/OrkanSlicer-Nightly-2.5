msgid "Index of the currently active nozzle. The index is zero-based (first nozzle has index 0)."
msgstr "Номер текущего активного сопла. Нумерация начинается с нуля (первое сопло имеет номер 0)."

# AI Translated
msgid "Nozzle diameters"
msgstr "Диаметры сопел"

# AI Translated
msgid "Nozzle diameters indexed by nozzle ID."
msgstr "Диаметры сопел, индексированные по ID сопла."

