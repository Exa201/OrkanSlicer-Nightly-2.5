#: src/slic3r/GUI/PresetComboBoxes.cpp:281 src/slic3r/GUI/PresetComboBoxes.cpp:349 src/slic3r/GUI/PresetComboBoxes.cpp:1079 src/slic3r/GUI/PresetComboBoxes.cpp:1153 src/slic3r/GUI/PresetComboBoxes.cpp:1375 src/slic3r/GUI/PresetComboBoxes.cpp:1429
msgid "System presets"
msgstr "Системные профили"

